ENVIRONMENT=development
# Logs are always one JSON object per line on stdout (NFR-OBS-01).
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://puremind:puremind@localhost:5432/puremind
CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=uploads

# Supabase project -> Settings -> API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Server-side only. Never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Only needed if the project still signs access tokens with the legacy HS256 JWT secret.
SUPABASE_JWT_SECRET=

# AI summaries/notebooks (OpenAI). Server-side only.
OPENAI_API_KEY=
# Tóm tắt, tổng hợp highlight và viết notebook: model nhỏ là đủ
OPENAI_MODEL=gpt-4o-mini
# Hỏi đáp với tài liệu: model mạnh hơn, câu trả lời ngắn nên chi phí vẫn thấp
OPENAI_CHAT_MODEL=gpt-4.1
# Model nhúng cho tính năng trò chuyện với tài liệu
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Số câu hỏi trò chuyện mỗi người mỗi ngày (mặc định 50)
CHAT_DAILY_QUOTA=50

# Save-by-link: URL or e-mail sent in the User-Agent (some sites, e.g. Wikipedia, require one).
# Empty = the first CORS origin.
WEB_FETCH_CONTACT=
