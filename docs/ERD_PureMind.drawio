        <mxCell id="legend" value="&lt;b&gt;Nhóm bảng&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;background:#DCEAF5;border:1px solid #315A78;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; Tài khoản, thư viện, highlight&lt;br&gt;&lt;span style=&quot;background:#FCE8D2;border:1px solid #A0612A;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; Reader v2 và Clean Reader (mới từ v1.5)&lt;br&gt;&lt;span style=&quot;background:#DFF1E3;border:1px solid #2F7A45;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; AI: tóm tắt, hỏi đáp, kết quả AI&lt;br&gt;&lt;span style=&quot;background:#ECE3F5;border:1px solid #6A4A8C;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; Notebook&lt;br&gt;&lt;span style=&quot;background:#E9ECEF;border:1px solid #5A6670;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; Quản trị và vận hành" style="text;html=1;align=left;verticalAlign=top;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="1630" y="460" width="260" height="150" as="geometry"/></mxCell>
        <mxCell id="note" value="&lt;b&gt;Ghi chú&lt;/b&gt;&lt;br&gt;highlights, notes, extraction_reports và chat_conversations còn có user_id (FK → users, chủ sở hữu, dùng để kiểm tra quyền); các quan hệ đó không vẽ để sơ đồ gọn. Mọi FK tới users/documents/notebooks là ON DELETE CASCADE, trừ documents.collection_id và admin_audit_log.admin_id (SET NULL). user_activity_daily.user_id không phải FK." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#FFFBEA;strokeColor=#C9A227;" vertex="1" parent="1"><mxGeometry x="1250" y="1080" width="630" height="120" as="geometry"/></mxCell>
