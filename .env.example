# Copy to .env and fill in values from your Supabase project (Settings -> API).
ENVIRONMENT=development
# Backend logs: one JSON object per line on stdout (NFR-OBS-01).
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Public key, safe for the browser.
SUPABASE_ANON_KEY=
# Server-side only. Never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Only for projects still using the legacy HS256 JWT secret.
SUPABASE_JWT_SECRET=

# AI summaries/notebooks (OpenAI). Server-side only: never put this key in a NEXT_PUBLIC_* variable.
OPENAI_API_KEY=
# Tóm tắt, tổng hợp highlight và viết notebook: model nhỏ là đủ
OPENAI_MODEL=gpt-4o-mini
# Hỏi đáp với tài liệu: model mạnh hơn, câu trả lời ngắn nên chi phí vẫn thấp
OPENAI_CHAT_MODEL=gpt-4.1
# Model nhúng cho tính năng trò chuyện với tài liệu
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Số câu hỏi trò chuyện mỗi người mỗi ngày (mặc định 50)
CHAT_DAILY_QUOTA=50

# Save-by-link: URL or e-mail sent in the User-Agent (some sites, e.g. Wikipedia, require one).
# Empty = the first CORS origin.
WEB_FETCH_CONTACT=

# Docker host ports (defaults 5432 / 8000 / 3000). If you change BACKEND_PORT or FRONTEND_PORT,
# update NEXT_PUBLIC_API_URL and CORS_ORIGINS to match.
# POSTGRES_PORT=5432
# BACKEND_PORT=8000
# FRONTEND_PORT=3000

NEXT_PUBLIC_API_URL=http://localhost:8000
